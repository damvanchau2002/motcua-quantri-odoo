<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Graph: thống kê theo dịch vụ -->
    <record id="view_student_request_service_stats_graph" model="ir.ui.view">
        <field name="name">student.service.request.graph</field>
        <field name="model">student.service.request</field>
        <field name="arch" type="xml">
            <graph string="Thống kê theo dịch vụ" type="bar">
                <field name="service_id" type="row"/>
            </graph>
        </field>
    </record>

    <!-- Pivot: thống kê theo dịch vụ -->
    <record id="view_student_request_service_stats_pivot" model="ir.ui.view">
        <field name="name">student.service.request.pivot</field>
        <field name="model">student.service.request</field>
        <field name="arch" type="xml">
            <pivot string="Thống kê theo dịch vụ">
                <field name="service_id" type="row"/>
            </pivot>
        </field>
    </record>

    <!-- Action: mở trực tiếp graph theo dịch vụ -->
    <record id="action_student_request_stats_graph" model="ir.actions.act_window">
        <field name="name">Biểu đồ thống kê</field>
        <field name="res_model">student.service.request</field>
        <field name="view_mode">graph,pivot,list,form</field>
        <field name="view_id" ref="view_student_request_service_stats_graph"/>
        <!-- Chúng ta dùng trực tiếp group_by trong context -->
        <field name="context">{"search_default_group_by_service": 1}</field>
    </record>

</odoo>